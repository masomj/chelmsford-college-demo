# Copy to .env on the server (and never commit .env).
#   cp .env.example .env && chmod 600 .env && nano .env
# docker compose reads this file both for variable substitution in
# docker-compose.yml and as the container's environment (env_file).

# ---- Docker network shared with the Caddy container ----
# The Docker network your Caddy container is on, so Caddy can reach this
# container as chelmsford-demo:8080. Find it with:
#   docker inspect -f '{{json .NetworkSettings.Networks}}' <caddy-container>
CADDY_NETWORK=CHANGE_ME_CADDY_NETWORK

# ---- Umbraco: unattended install on first start ----
# Creates the database and this back-office admin user when /app/data is empty.
Umbraco__CMS__Unattended__InstallUnattended=true
Umbraco__CMS__Unattended__UnattendedUserName=Demo Admin
Umbraco__CMS__Unattended__UnattendedUserEmail=admin@example.com
# At least 10 characters. Use a long random value, e.g. `openssl rand -base64 24`.
Umbraco__CMS__Unattended__UnattendedUserPassword=CHANGE_ME_LONG_RANDOM_PASSWORD

# Public URL, used for absolute links, emails and payment return URLs.
Umbraco__CMS__WebRouting__UmbracoApplicationUrl=https://chelmsford.vanguarddigitalsolutions.co.uk

# Secret that signs image URLs, so nobody can request arbitrary resizes.
# Generate with `openssl rand -base64 64` (remove any line breaks so it is one
# line). Never commit a real value.
Umbraco__CMS__Imaging__HMACSecretKey=

# ---- Stakeholder (tender panel) access ----
# Shared reviewer account for the CMS back office (Editor group). Placeholders
# only here: set real values in the server's .env, never in git.
Panel__CmsUser__Name=Tender Panel
Panel__CmsUser__Email=panel@example.com
Panel__CmsUser__Password=CHANGE_ME_LONG_RANDOM_PASSWORD

# Private access-tracking report at /reports/access (protected by the app's
# own basic auth; Caddy leaves /reports/* alone).
Reports__UserName=CHANGE_ME_REPORTS_USER
Reports__Password=CHANGE_ME_LONG_RANDOM_PASSWORD

# Email this address when the panel first visits each day or signs in.
Access__NotifyEmail=

# ---- Outgoing email (SMTP) ----
# Sender for the email outbox. For example Gmail with an app password:
# Smtp__Host=smtp.gmail.com and the app password in Smtp__Password.
Smtp__Host=
Smtp__Port=587
Smtp__UserName=
Smtp__Password=
Smtp__FromAddress=
Smtp__EnableSsl=true

# ---- Payments ----
# Where duplicate-payment refund alerts go (the finance team's address).
Payments__FinanceEmail=

# Live Stripe keys (sk_live_..., pk_live_...) are refused unless this is true.
# Keep it false on the demo.
Payments__AllowLiveKeys=false

# Leave the three Stripe values empty to use the built-in, clearly labelled
# test checkout (no Stripe account needed, no money moves).
# Set Stripe TEST keys (sk_test_..., pk_test_...) to use Stripe's hosted
# checkout in test mode. Never put live keys on the demo.
Payments__Stripe__SecretKey=
Payments__Stripe__PublishableKey=
# Signing secret (whsec_...) for the webhook endpoint
# https://chelmsford.vanguarddigitalsolutions.co.uk/pay/webhook/stripe
Payments__Stripe__WebhookSecret=
