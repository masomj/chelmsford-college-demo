{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "SiteData": "Data Source=../../data/site.db",
    "CollegeSource": "Data Source=../../data/college-source.db"
  },
  "College": {
    "ContentPath": "../../college-content",
    "DataPath": "../../data"
  },
  "Integration": {
    "SyncIntervalMinutes": 5
  },
  "Payments": {
    "Stripe": {
      "SecretKey": "",
      "WebhookSecret": "",
      "PublishableKey": ""
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "ce718921-82ba-470c-88fd-6f5d99b39d8f"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Security": {
        "AllowConcurrentLogins": true
      }
    }
  }
}