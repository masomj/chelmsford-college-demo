@model IReadOnlyDictionary<string, string>
@* Errors keyed by the id of the field they belong to, in the order the fields appear. *@
@if (Model.Count > 0)
{
    <div class="error-summary" role="alert" aria-labelledby="error-summary-title" tabindex="-1" data-error-summary>
        <h2 id="error-summary-title">There is a problem</h2>
        <ul>
            @foreach (var (field, message) in Model)
            {
                <li><a href="#@field">@message</a></li>
            }
        </ul>
    </div>
}
