@model IReadOnlyList<(string Text, string? Url)>
@if (Model.Count > 0)
{
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
            @foreach (var (text, url) in Model)
            {
                if (url is null)
                {
                    <li aria-current="page">@text</li>
                }
                else
                {
                    <li><a href="@url">@text</a></li>
                }
            }
        </ol>
    </nav>
}
