@model EventViewModel
@{
    var e = Model.Event;
    IReadOnlyList<(string Text, string? Url)> crumbs = [("Home", "/"), ("Events", Model.EventsUrl), (e.Name, null)];
    var full = Model.PlacesLeft is 0;
    var canBook = e.BookingOpen && !full && !Model.IsPast;
    var f = Model.Form;
    string? Err(string key) => Model.Errors.TryGetValue(key, out var m) ? m : null;
    var orderedErrors = new[] { "Name", "Email", "AttendeeType", "People" }
        .Where(Model.Errors.ContainsKey)
        .ToDictionary(k => "book-" + k, k => Model.Errors[k]);
    var calendarUrl = $"/events/calendar/{e.Key:D}.ics";
}

<div class="wrap">
    <partial name="~/Views/Shared/_Breadcrumb.cshtml" model="crumbs" />
    <div class="event-layout">
        <div>
            @Html.Picture(Model.Picture, "(min-width: 64rem) 760px, 100vw", "event-hero__img", eager: true, alt: "")
            <p class="event-type event-type--spaced">@e.Type</p>
            <h1>@e.Name</h1>

            <ul class="event-facts">
                <li>
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
                    <p><strong>@UkTime.LongDate(e.StartsAt)</strong> <span class="muted">@UkTime.TimeRange(e.StartsAt, e.EndsAt)</span></p>
                </li>
                @if (!string.IsNullOrEmpty(e.Venue) || !string.IsNullOrEmpty(e.Address))
                {
                    <li>
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
                        <div>
                            <p><strong>@e.Venue</strong></p>
                            @if (!string.IsNullOrEmpty(e.Address))
                            {
                                <address class="muted address">@Html.Raw(string.Join("<br>", e.Address.Replace("\r", string.Empty).Split('\n', StringSplitOptions.RemoveEmptyEntries).Select(l => System.Net.WebUtility.HtmlEncode(l.Trim()))))</address>
                            }
                        </div>
                    </li>
                }
                <li>
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"></circle><path d="M9 12h6M12 9v6"></path></svg>
                    <p>
                        <strong>Free. Booking required</strong>
                        @if (Model.PlacesLeft is { } left)
                        {
                            <span class="muted">@(left == 0 ? "This event is fully booked." : left == 1 ? "1 place left." : $"{left} places left.")</span>
                        }
                    </p>
                </li>
            </ul>

            <div class="event-actions">
                @if (canBook)
                {
                    <a class="btn" href="#book">Book your place</a>
                }
                <a class="btn btn--ghost" href="@calendarUrl" download>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M12 13v5M9.5 15.5h5"></path></svg>
                    Add to calendar
                </a>
            </div>

            <h2>About this event</h2>
            <div class="prose">
                @if (!string.IsNullOrEmpty(e.BodyHtml))
                {
                    @Html.RichText(e.BodyHtml)
                }
                else if (!string.IsNullOrEmpty(e.Summary))
                {
                    <p>@e.Summary</p>
                }
            </div>
        </div>

        <section id="book" class="booking panel" aria-labelledby="book-heading">
            @if (Model.Booked)
            {
                <div>
                    <div class="tick" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"></path></svg></div>
                    @* Focus moves here after the booking, so a screen reader announces the confirmation. *@
                    <h2 id="book-heading" tabindex="-1" data-autofocus>You're booked in</h2>
                    <p>We'll email your confirmation. See you on @UkTime.DayAndDate(e.StartsAt).</p>
                    <p class="muted">This is a demo site, so no email is actually sent.</p>
                    <a class="btn btn--ghost btn--block" href="@calendarUrl" download>Add to calendar</a>
                </div>
            }
            else if (Model.IsPast)
            {
                <h2 id="book-heading">This event has finished</h2>
                <p><a href="@Model.EventsUrl">See upcoming events</a></p>
            }
            else if (!e.BookingOpen || full)
            {
                <h2 id="book-heading">@(full ? "This event is fully booked" : "Booking has closed")</h2>
                <p>@(full ? "All the places have been taken." : "We're not taking bookings for this event.") <a href="@Model.EventsUrl">See other events</a>.</p>
            }
            else
            {
                <h2 id="book-heading">Book your place</h2>
                <p class="muted">We'll email your confirmation.</p>
                @if (Model.BookingProblem is { } problem)
                {
                    <div class="notice notice--warning" role="alert" tabindex="-1" data-autofocus><p>@problem</p></div>
                }
                <partial name="~/Views/Shared/_ErrorSummary.cshtml" model="(IReadOnlyDictionary<string, string>)orderedErrors" />
                <form action="/events/book" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="EventKey" value="@e.Key">
                    <div class="field @(Err("Name") is null ? null : "field--error")">
                        <label class="field__label" for="book-Name">Full name</label>
                        @if (Err("Name") is { } en) { <span class="field__error" id="book-Name-error">@en</span> }
                        <input class="input @(Err("Name") is null ? null : "input--error")" id="book-Name" name="Name" type="text" autocomplete="name" value="@f.Name" aria-describedby="@(Err("Name") is null ? null : "book-Name-error")" aria-invalid="@(Err("Name") is null ? null : "true")">
                    </div>
                    <div class="field @(Err("Email") is null ? null : "field--error")">
                        <label class="field__label" for="book-Email">Email address</label>
                        <span class="field__hint" id="book-Email-hint">We'll send your confirmation here</span>
                        @if (Err("Email") is { } ee) { <span class="field__error" id="book-Email-error">@ee</span> }
                        <input class="input @(Err("Email") is null ? null : "input--error")" id="book-Email" name="Email" type="email" autocomplete="email" spellcheck="false" value="@f.Email" aria-describedby="book-Email-hint@(Err("Email") is null ? null : " book-Email-error")" aria-invalid="@(Err("Email") is null ? null : "true")">
                    </div>
                    <div class="field @(Err("AttendeeType") is null ? null : "field--error")">
                        <label class="field__label" for="book-AttendeeType">I am</label>
                        @if (Err("AttendeeType") is { } ea) { <span class="field__error" id="book-AttendeeType-error">@ea</span> }
                        <select class="select" id="book-AttendeeType" name="AttendeeType" aria-describedby="@(Err("AttendeeType") is null ? null : "book-AttendeeType-error")" aria-invalid="@(Err("AttendeeType") is null ? null : "true")">
                            <option value="">Choose one</option>
                            @foreach (var t in EventViewModel.AttendeeTypes)
                            {
                                <option value="@t" selected="@(f.AttendeeType == t)">@t</option>
                            }
                        </select>
                    </div>
                    <div class="field @(Err("People") is null ? null : "field--error")">
                        <label class="field__label" for="book-People">How many people are coming?</label>
                        <span class="field__hint" id="book-People-hint">Including you</span>
                        @if (Err("People") is { } ep) { <span class="field__error" id="book-People-error">@ep</span> }
                        <select class="select" id="book-People" name="People" aria-describedby="book-People-hint@(Err("People") is null ? null : " book-People-error")">
                            @for (var n = 1; n <= 4; n++)
                            {
                                <option value="@n" selected="@(f.People == n)">@n</option>
                            }
                        </select>
                    </div>
                    <button class="btn btn--block" type="submit">Confirm booking</button>
                </form>
            }
        </section>
    </div>
</div>
